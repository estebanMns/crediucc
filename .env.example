# Plantilla de variables de entorno de CrediUCC.
# Copia este archivo como .env y reemplaza los valores. El .env NUNCA se sube a GitHub.

# --- Supabase (Project Settings -> API / Data API) ---------------------------
# URL del proyecto: https://<project-ref>.supabase.co
SUPABASE_URL=https://TU-PROJECT-REF.supabase.co
# Llave pública (publishable / anon). Con ella la API registra, inicia sesión y verifica tokens.
# No hace falta la llave secreta (service_role): no la pongas aquí.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# --- Conexión directa a la base de datos Postgres ----------------------------
# Supabase -> botón "Connect" -> "Session pooler" (funciona en redes IPv4).
# Si la contraseña tiene caracteres especiales (@ : / ? #), escríbelos codificados (%40, %3A ...).
DATABASE_URL=postgresql://postgres.TU-PROJECT-REF:TU-PASSWORD@aws-0-us-east-1.pooler.supabase.com:5432/postgres

# --- API de CrediUCC -----------------------------------------------------------
APP_VERSION=1.0.0
APP_HEALTHY=true
CENTRAL_RIESGO_LATENCIA_MS=0
CLOUD_ENABLED=false

# El frontend tiene su propio archivo: frontend/.env.local (plantilla en frontend/.env.example).
