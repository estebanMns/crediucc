# Plantilla de variables del frontend (Next.js). Copia este archivo como .env.local.
# El .env.local NUNCA se sube a GitHub (está en frontend/.gitignore).

# URL de la API de CrediUCC (backend FastAPI). Next reenvía allí /api/* y /health,
# así el navegador nunca habla directo con la API ni necesita CORS.
API_URL=http://127.0.0.1:8001
